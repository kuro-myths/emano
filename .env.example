APP_NAME="Pusat Surat Elektronik"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=info

# Model autentikasi kustom (tabel "pengguna")
AUTH_MODEL='App\Models\Pengguna'

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pusat_surat
DB_USERNAME=pusat_surat
DB_PASSWORD=ganti-kata-sandi-ini

SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

BCRYPT_ROUNDS=12
VITE_APP_NAME="${APP_NAME}"
